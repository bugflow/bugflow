# The values of a local run. `make env` copies this file to .env,
# generates the three secrets marked below, and renders the templates
# in deployments/env/ from it into env/. Neither .env nor env/ is
# committed.
#
# Each name is a template variable. docs/deploying.md describes every
# one, including those not listed here, which have defaults.

bugflow_postgres_user=bugflow
bugflow_database=bugflow
# Generated by make env.
vault_bugflow_postgres_password=
vault_bugflow_webhook_secret=
vault_bugflow_litellm_master_key=

# The repositories this server watches, comma-separated: owner/repo, or
# forgejo:owner/repo for one on the Forgejo named below.
bugflow_watched_repositories=
# The public address a forge posts deliveries to.
bugflow_ingress_url=
# A token for the forge: read pull requests and contents, write pull
# request comments, labels and commit statuses, on the watched
# repositories alone.
vault_bugflow_forge_token=
bugflow_forgejo_url=
vault_bugflow_forgejo_token=

# The model that fills each role, as the proxy names models, and the
# key it is called with. The worker does not review until every role
# has a model.
bugflow_small_model=
vault_bugflow_small_api_key=
bugflow_medium_model=
vault_bugflow_medium_api_key=
bugflow_large_model=
vault_bugflow_large_api_key=

# The identity provider the API checks tokens against. The API does not
# start until all five are given.
project_oidc_issuer=
project_oidc_audience=
#project_oidc_clients.policies-pipeline.client_id=
bugflow_roles_claim=
bugflow_policy_deployer_role=
