# The key every caller of the proxy presents. The worker holds it too.
LITELLM_MASTER_KEY={{ vault_bugflow_litellm_master_key }}
# The model that fills each role, as the proxy names models, and the
# key it is called with.
ROLE_SMALL_MODEL={{ bugflow_small_model | default('') }}
ROLE_SMALL_API_KEY={{ vault_bugflow_small_api_key | default('') }}
ROLE_MEDIUM_MODEL={{ bugflow_medium_model | default('') }}
ROLE_MEDIUM_API_KEY={{ vault_bugflow_medium_api_key | default('') }}
ROLE_LARGE_MODEL={{ bugflow_large_model | default('') }}
ROLE_LARGE_API_KEY={{ vault_bugflow_large_api_key | default('') }}
{% if bugflow_otel_endpoint | default('') %}
# Where the proxy's traces and what each call cost go, read only if
# litellm/config.yaml names the otel callback. Never the prompts or the
# completions.
OTEL_EXPORTER=otlp_grpc
OTEL_EXPORTER_OTLP_ENDPOINT={{ bugflow_otel_endpoint }}
OTEL_SERVICE_NAME=litellm
LITELLM_OTEL_INTEGRATION_ENABLE_METRICS=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
{% endif %}
