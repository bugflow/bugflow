# Read by the worker, and by `bugflow webhooks` when it is run.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE={{ bugflow_temporal_namespace | default('default') }}
TEMPORAL_TASK_QUEUE={{ bugflow_temporal_task_queue | default('bugflow') }}
DATABASE_URL=postgresql://{{ bugflow_postgres_user }}:{{ vault_bugflow_postgres_password }}@postgres:5432/{{ bugflow_database }}
# The time zone a calendar period starts and ends in, as an IANA name.
PERIODS_TIMEZONE={{ bugflow_periods_timezone | default('UTC') }}
# The repositories this server watches, comma-separated, each owner/repo
# or forgejo:owner/repo. A stocktake is scheduled for each, and
# `bugflow webhooks` registers a webhook on each.
WATCHED_REPOSITORIES={{ bugflow_watched_repositories | default('') }}
# The public address a forge posts deliveries to, which
# `bugflow webhooks` registers, and the secret deliveries are signed
# with.
INGRESS_URL={{ bugflow_ingress_url | default('') }}
WEBHOOK_SECRET={{ vault_bugflow_webhook_secret }}
{% if vault_bugflow_forge_token | default('') %}
# The token pull requests are fetched and answered with.
FORGE_TOKEN={{ vault_bugflow_forge_token }}
{% endif %}
{% if bugflow_forgejo_url | default('') %}
# A Forgejo whose pull requests are reviewed, and a token for it.
FORGEJO_URL={{ bugflow_forgejo_url }}
FORGEJO_TOKEN={{ vault_bugflow_forgejo_token }}
{% endif %}
{% if bugflow_review_agents | default('') %}
# The reviewers this worker runs, by id, comma-separated. Not written,
# every reviewer the deployment in force holds.
REVIEW_AGENTS={{ bugflow_review_agents }}
{% endif %}
# The proxy models are called through, and the key it asks of a caller.
JUDGE_URL=http://litellm:4000
LITELLM_MASTER_KEY={{ vault_bugflow_litellm_master_key }}
# Requests a second each judging queue allows, across every worker on
# it. A class of model with no rate of its own takes the first.
JUDGE_REQUESTS_PER_SECOND={{ bugflow_judge_requests_per_second | default('0.2') }}
{% if bugflow_judge_requests_per_second_small | default('') %}
JUDGE_REQUESTS_PER_SECOND_SMALL={{ bugflow_judge_requests_per_second_small }}
{% endif %}
{% if bugflow_judge_requests_per_second_medium | default('') %}
JUDGE_REQUESTS_PER_SECOND_MEDIUM={{ bugflow_judge_requests_per_second_medium }}
{% endif %}
{% if bugflow_judge_requests_per_second_large | default('') %}
JUDGE_REQUESTS_PER_SECOND_LARGE={{ bugflow_judge_requests_per_second_large }}
{% endif %}
# What each class of model asks the proxy for: by default the role of
# the class's own name.
LLM_MODEL_SMALL={{ bugflow_model_class_small | default('small') }}
LLM_MODEL_MEDIUM={{ bugflow_model_class_medium | default('medium') }}
LLM_MODEL_LARGE={{ bugflow_model_class_large | default('large') }}
{% if bugflow_judge_model | default('') %}
# One model for every class, overriding all of them.
JUDGE_MODEL={{ bugflow_judge_model }}
{% endif %}
{% if bugflow_tokenomic_s3_bucket | default('') %}
# The bucket the content of every call to a model is kept in. Not
# written, each call's cost is still recorded and its content is kept
# nowhere.
TOKENOMIC_S3_ENDPOINT={{ bugflow_tokenomic_s3_endpoint }}
TOKENOMIC_S3_REGION={{ bugflow_tokenomic_s3_region | default('') }}
TOKENOMIC_S3_BUCKET={{ bugflow_tokenomic_s3_bucket }}
TOKENOMIC_S3_ACCESS_KEY={{ vault_bugflow_tokenomic_s3_access_key }}
TOKENOMIC_S3_SECRET_KEY={{ vault_bugflow_tokenomic_s3_secret_key }}
{% endif %}
{% if bugflow_review_runner | default('') %}
# The runner reviews are dispatched to, the model its sessions run, the
# key sessions are started with, and a token that can only read the
# repositories a session mounts. Not written, nothing is dispatched.
REVIEW_RUNNER={{ bugflow_review_runner }}
REVIEW_AGENT_MODEL={{ bugflow_review_agent_model }}
REVIEW_ANTHROPIC_API_KEY={{ vault_bugflow_review_runner_api_key }}
REVIEW_REPOSITORY_TOKEN={{ vault_bugflow_review_repository_token }}
{% if bugflow_review_completion_webhook | default('') %}
REVIEW_COMPLETION_WEBHOOK={{ bugflow_review_completion_webhook }}
{% endif %}
{% if bugflow_forge_clone_url | default('') %}
FORGE_CLONE_URL={{ bugflow_forge_clone_url }}
{% endif %}
{% endif %}
{% if project_build_sha is defined %}
# The full git sha of the commit the image was built from, recorded with
# every journal entry. Not written where nothing supplies it.
BUILD_SHA={{ project_build_sha }}
{% endif %}
{% if bugflow_policy_checks is defined %}
# The checks this server performs, comma-separated. Not written, they
# are the ones the package has. Written empty, a manifest naming a check
# is refused.
POLICY_CHECKS={{ bugflow_policy_checks }}
{% endif %}
