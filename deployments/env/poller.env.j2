# The poller lists pull requests at the forge and posts each change to
# the ingress, signed as the forge would sign it.
POLL_REPOSITORIES={{ bugflow_watched_repositories | default('') }}
POLL_INTERVAL_SECONDS={{ bugflow_poll_interval_seconds | default('60') }}
INGRESS_URL=http://ingress:8000
WEBHOOK_SECRET={{ vault_bugflow_webhook_secret }}
{% if vault_bugflow_forge_token | default('') %}
FORGE_TOKEN={{ vault_bugflow_forge_token }}
{% endif %}
{% if bugflow_forgejo_url | default('') %}
FORGEJO_URL={{ bugflow_forgejo_url }}
FORGEJO_TOKEN={{ vault_bugflow_forgejo_token }}
{% endif %}
{% if bugflow_otel_endpoint | default('') %}
# Where traces go, over OTLP, and log lines written to stdout as JSON for
# the collector that reads them. Not written, nothing is exported and
# log lines are plain text.
OTEL_EXPORTER_OTLP_ENDPOINT={{ bugflow_otel_endpoint }}
LOG_FORMAT=contract
{% endif %}
