# The poller lists pull requests at the forge and posts each change to
# the ingress, signed as the forge would sign it.
# It polls each repository a gnome judges, by the settings kept here.
DATABASE_URL=postgresql://{{ bugflow_postgres_user }}:{{ vault_bugflow_postgres_password }}@postgres:5432/{{ bugflow_database }}
POLL_INTERVAL_SECONDS={{ bugflow_poll_interval_seconds | default('60') }}
INGRESS_URL=http://ingress:8000
WEBHOOK_SECRET={{ vault_bugflow_webhook_secret }}
{% if vault_bugflow_forge_token | default('') %}
FORGE_TOKEN={{ vault_bugflow_forge_token }}
{% endif %}
{% if vault_bugflow_forge_tokens_by_owner | default('') %}
FORGE_TOKENS_BY_OWNER={{ vault_bugflow_forge_tokens_by_owner }}
{% endif %}
{% if bugflow_forge_app_id | default('') %}
# The GitHub App signed in as, which GitHub attributes comments, labels
# and statuses to as its bot: its id, its private key with each line
# break written as \n, and the installation on each owner it is
# installed on, as owner=id pairs separated by commas. An owner named
# here is reached with the App's installation token, minted and renewed
# by the program; one named in FORGE_TOKENS_BY_OWNER with its own token
# instead.
FORGE_APP_ID={{ bugflow_forge_app_id }}
FORGE_APP_PRIVATE_KEY={{ vault_bugflow_forge_app_private_key | replace('\n', '\\n') }}
FORGE_APP_INSTALLATIONS={{ bugflow_forge_app_installations | default('') }}
{% endif %}
{% if bugflow_forgejo_url | default('') %}
FORGEJO_URL={{ bugflow_forgejo_url }}
FORGEJO_TOKEN={{ vault_bugflow_forgejo_token }}
{% endif %}
{% if bugflow_otel_endpoint | default('') %}
# Where traces go, over OTLP, and log lines written to stdout as JSON for
# the collector that reads them. Not written, nothing is exported and
# log lines are plain text.
OTEL_EXPORTER_OTLP_ENDPOINT={{ bugflow_otel_endpoint }}
LOG_FORMAT=contract
{% endif %}
