TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE={{ bugflow_temporal_namespace | default('default') }}
TEMPORAL_TASK_QUEUE={{ bugflow_temporal_task_queue | default('bugflow') }}
DATABASE_URL=postgresql://{{ bugflow_postgres_user }}:{{ vault_bugflow_postgres_password }}@postgres:5432/{{ bugflow_database }}
# What a forge signs its deliveries with.
WEBHOOK_SECRET={{ vault_bugflow_webhook_secret }}
{% if vault_bugflow_webhook_secret_previous | default('') %}
# Supplied only while the secret is rotated: deliveries signed with the
# previous secret are accepted too.
WEBHOOK_SECRET_PREVIOUS={{ vault_bugflow_webhook_secret_previous }}
{% endif %}
{% if vault_bugflow_review_webhook_secret | default('') %}
# What a managed agent's platform signs its completion webhook with.
# Not written, that route accepts nothing.
REVIEW_WEBHOOK_SECRET={{ vault_bugflow_review_webhook_secret }}
{% endif %}
{% if bugflow_temporal_ui_url | default('') %}
# The address people reach the workflow console at, for links to it.
TEMPORAL_UI_URL={{ bugflow_temporal_ui_url }}
{% endif %}
{% if project_build_sha is defined %}
# The full git sha of the commit the image was built from, recorded with
# every journal entry. Not written where nothing supplies it.
BUILD_SHA={{ project_build_sha }}
{% endif %}
{% if bugflow_policy_checks is defined %}
# The checks this server performs, comma-separated. Not written, they
# are the ones the package has. Written empty, a manifest naming a check
# is refused.
POLICY_CHECKS={{ bugflow_policy_checks }}
{% endif %}
