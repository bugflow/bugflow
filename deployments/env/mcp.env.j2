# Optional service: enable the mcp Compose profile after configuring its
# identity provider and the API audience. This service reads through HTTP.
MCP_ISSUER={{ bugflow_mcp_issuer | default('') }}
MCP_AUDIENCE={{ bugflow_mcp_audience | default('') }}
MCP_CLIENTS={{ bugflow_mcp_clients | default('') }}
MCP_ROLES_CLAIM={{ bugflow_mcp_roles_claim | default('') }}
MCP_EXCHANGE_CLIENT_ID={{ bugflow_mcp_exchange_client_id | default('') }}
# Single quotes keep dollar signs in the client secret literal.
MCP_EXCHANGE_CLIENT_SECRET='{{ vault_bugflow_mcp_exchange_client_secret | default('') | replace("'", "\\'") }}'
MCP_API_AUDIENCE={{ bugflow_mcp_api_audience | default('') }}
MCP_API_URL={{ bugflow_mcp_api_url | default('http://api:8000') }}
MCP_PUBLIC_URL={{ bugflow_mcp_public_url | default('') }}
