DATABASE_URL=postgresql://{{ bugflow_postgres_user }}:{{ vault_bugflow_postgres_password }}@postgres:5432/{{ bugflow_database }}
# The identity provider whose tokens the API accepts: its address, and
# the audience a token must be addressed to. Without both the API does
# not start.
API_ISSUER={{ project_oidc_issuer | default('') }}
API_AUDIENCE={{ project_oidc_audience | default('') }}
{% if bugflow_api_clients is defined %}
# Clients permitted to call the API, including interactive clients.
API_CLIENTS={{ bugflow_api_clients }}
{% elif 'policies-pipeline' in (project_oidc_clients | default({})) %}
# The client a policy repository's pipeline signs in as. Not written
# until that client is registered, and the API does not start without
# it.
API_CLIENTS={{ project_oidc_clients['policies-pipeline'].client_id }}
{% endif %}
# The claim of a token that lists a caller's roles, and the role that
# may deploy policies. Identity providers name both differently.
API_ROLES_CLAIM={{ bugflow_roles_claim }}
POLICY_DEPLOYER_ROLE={{ bugflow_policy_deployer_role }}
{% if bugflow_evaluation_admin_role is defined %}
# This role may read all evaluation data.
EVALUATION_ADMIN_ROLE={{ bugflow_evaluation_admin_role }}
{% endif %}
{% if bugflow_evaluation_identities is defined %}
# Commit email aliases keyed by issuer and subject. Single quotes prevent
# Compose interpolation; JSON escapes preserve apostrophes within values.
EVALUATION_IDENTITIES='{{ bugflow_evaluation_identities | replace("'", "\\u0027") }}'
{% endif %}
{% if bugflow_settings_role is defined %}
# This role may read and change what each gnome does on each repository,
# at /api/settings and on the page at /settings. Not written, neither is
# served.
SETTINGS_ROLE={{ bugflow_settings_role }}
{% endif %}
{% if bugflow_settings_client_id is defined %}
# The public client the settings page signs a person in as, which must
# be one of API_CLIENTS, and the scopes it asks for, which must give a
# token for API_AUDIENCE carrying the person's roles.
SETTINGS_CLIENT_ID={{ bugflow_settings_client_id }}
SETTINGS_SCOPE={{ bugflow_settings_scope | default('openid profile') }}
{% endif %}
{% if project_build_sha is defined %}
# The full git sha of the commit the image was built from, recorded with
# every journal entry. Not written where nothing supplies it.
BUILD_SHA={{ project_build_sha }}
{% endif %}
{% if bugflow_policy_checks is defined %}
# The checks this server performs, comma-separated. Not written, they
# are the ones the package has. Written empty, a manifest naming a check
# is refused.
POLICY_CHECKS={{ bugflow_policy_checks }}
{% endif %}
{% if bugflow_otel_endpoint | default('') %}
# Where traces go, over OTLP, and log lines written to stdout as JSON for
# the collector that reads them. Not written, nothing is exported and
# log lines are plain text.
OTEL_EXPORTER_OTLP_ENDPOINT={{ bugflow_otel_endpoint }}
LOG_FORMAT=contract
{% endif %}
