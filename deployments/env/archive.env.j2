DATABASE_URL=postgresql://{{ bugflow_postgres_user }}:{{ vault_bugflow_postgres_password }}@postgres:5432/{{ bugflow_database }}
{% if bugflow_database_scripts | default('') %}
# The directories of this deployment's own database scripts, a branch
# of the package's, separated by whitespace. Not written where the
# deployment has no tables of its own.
DATABASE_SCRIPTS={{ bugflow_database_scripts }}
{% endif %}
# Where the worker's scheduler is, so an append can ask the worker to
# index what it kept for search. Without it the worker's schedule reads
# the ledger within its interval instead.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE={{ bugflow_temporal_namespace | default('default') }}
TEMPORAL_TASK_QUEUE={{ bugflow_temporal_task_queue | default('bugflow') }}
# The identity provider whose tokens the archive host accepts: its
# address, and the audience a token must be addressed to.
ARCHIVE_ISSUER={{ project_oidc_issuer | default('') }}
ARCHIVE_AUDIENCE={{ project_oidc_audience | default('') }}
{% if bugflow_archive_clients is defined %}
# Clients a token may come from. The first is the one sealing tools are
# told to sign in as.
ARCHIVE_CLIENTS={{ bugflow_archive_clients }}
{% elif 'coding-agent' in (project_oidc_clients | default({})) %}
# The client a person's own tools sign in as. Not written until it is
# registered, and the host does not start without it.
ARCHIVE_CLIENTS={{ project_oidc_clients['coding-agent'].client_id }}
{% endif %}
# The claim of a token that lists a caller's roles, the role that may
# read every ledger kept here, and the role that may also append.
ARCHIVE_ROLES_CLAIM={{ bugflow_roles_claim }}
ARCHIVE_READER_ROLE={{ bugflow_archive_reader_role | default('bugflow-archive-reader') }}
ARCHIVE_WRITER_ROLE={{ bugflow_archive_writer_role | default('bugflow-archive-writer') }}
{% if bugflow_archive_scopes | default('') %}
# The scopes sealing tools are told to ask for, separated by spaces.
# Not written, they ask for openid alone.
ARCHIVE_SCOPES={{ bugflow_archive_scopes }}
{% endif %}
{% if bugflow_archive_s3_bucket | default('') %}
# The bucket kept archives go in, off the host, and a key that reaches
# it alone. Not written, the host does not start: an event would be
# recorded whose bytes are held nowhere.
ARCHIVE_S3_ENDPOINT={{ bugflow_archive_s3_endpoint }}
ARCHIVE_S3_REGION={{ bugflow_archive_s3_region | default('') }}
ARCHIVE_S3_BUCKET={{ bugflow_archive_s3_bucket }}
ARCHIVE_S3_ACCESS_KEY={{ vault_bugflow_archive_s3_access_key }}
ARCHIVE_S3_SECRET_KEY={{ vault_bugflow_archive_s3_secret_key }}
{% endif %}
{% if bugflow_archive_max_upload_bytes | default('') %}
# The largest append the host takes, in bytes. The host holds an append
# whole in memory while it verifies it. Not written, the package's
# default stands.
ARCHIVE_MAX_UPLOAD_BYTES={{ bugflow_archive_max_upload_bytes }}
{% endif %}
{% if bugflow_archive_protocols | default('') %}
# The versions of the remote archive protocol the host serves, such as
# "2" or "1,2". Not written, the host serves every version it has.
ARCHIVE_PROTOCOLS={{ bugflow_archive_protocols }}
{% endif %}
{% if bugflow_archive_retiring | default('') %}
# The date after which a version stops being served, as "1=2027-01-31".
ARCHIVE_RETIRING={{ bugflow_archive_retiring }}
{% endif %}
{% if project_build_sha is defined %}
# The full git sha of the commit the image was built from, recorded with
# every journal entry. Not written where nothing supplies it.
BUILD_SHA={{ project_build_sha }}
{% endif %}
{% if bugflow_otel_endpoint | default('') %}
# Where traces go, over OTLP, and log lines written to stdout as JSON for
# the collector that reads them. Not written, nothing is exported and
# log lines are plain text.
OTEL_EXPORTER_OTLP_ENDPOINT={{ bugflow_otel_endpoint }}
LOG_FORMAT=contract
{% endif %}
